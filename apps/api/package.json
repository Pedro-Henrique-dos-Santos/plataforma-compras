{
  "name": "@compras/api",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @compras/contracts build && pnpm --filter @compras/database build",
    "predev": "pnpm --filter @compras/contracts build && pnpm --filter @compras/database build",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @compras/contracts build && pnpm --filter @compras/database build",
    "test": "vitest run",
    "pretest:integration": "pnpm --filter @compras/contracts build && pnpm --filter @compras/database build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@compras/contracts": "workspace:*",
    "@compras/database": "workspace:*",
    "@napi-rs/canvas": "^1.0.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.110.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.0",
    "file-type": "^22.0.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.1.200",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
