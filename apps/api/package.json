{
  "name": "@compras/api",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @compras/contracts build && pnpm --filter @compras/database build",
    "predev": "pnpm --filter @compras/contracts build && pnpm --filter @compras/database build",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @compras/contracts build && pnpm --filter @compras/database build",
    "test": "vitest run",
    "pretest:integration": "pnpm --filter @compras/contracts build && pnpm --filter @compras/database build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@compras/contracts": "workspace:*",
    "@compras/database": "workspace:*",
    "@napi-rs/canvas": "^1.0.10",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tesseract.js-data/por": "1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^22.1.1",
    "googleapis": "^183.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
