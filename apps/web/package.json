{
  "name": "@compras/web",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @compras/contracts build",
    "predev": "pnpm --filter @compras/contracts build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "pretest": "pnpm --filter @compras/contracts build",
    "test": "vitest run",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@compras/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.28.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
