# Web
VITE_API_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DEMO_MODE=true

# API
PORT=3333
NODE_ENV=development
DEMO_MODE=true
APP_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compras
PLATFORM_OWNER_EMAILS=proprietario@exemplo.com
REQUIRE_VERIFIED_EMAIL=true
TRUST_PROXY=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
INVOICE_STORAGE_BUCKET=invoice-documents
OCR_LANGUAGE_DATA_PATH=

# NF-e / SEFAZ. Comece em SHADOW e habilite o worker somente apos homologacao.
FISCAL_CREDENTIAL_ENCRYPTION_KEY=
FISCAL_ROLLOUT_MODE=SHADOW
FISCAL_SYNC_WORKER_ENABLED=false
FISCAL_SYNC_POLL_INTERVAL_MS=60000
SEFAZ_REQUEST_TIMEOUT_MS=30000
SEFAZ_NFE_DISTRIBUTION_HOMOLOGATION_URL=
SEFAZ_NFE_DISTRIBUTION_PRODUCTION_URL=
SEFAZ_NFE_MANIFESTATION_HOMOLOGATION_URL=
SEFAZ_NFE_MANIFESTATION_PRODUCTION_URL=

# Notificacoes
NOTIFICATION_WORKER_ENABLED=true
# log | live
NOTIFICATION_DELIVERY_MODE=log
NOTIFICATION_POLL_INTERVAL_MS=10000
NOTIFICATION_REQUEST_TIMEOUT_MS=15000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_APPROVAL_TEMPLATE=
WHATSAPP_REJECTION_TEMPLATE=
WHATSAPP_FINANCE_TEMPLATE=
WHATSAPP_FISCAL_TEMPLATE=
