{
  "name": "plataforma-compras",
  "version": "0.7.1",
  "private": true,
  "description": "Plataforma multiempresa para gestao, inteligencia e controle de compras.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @compras/web --filter @compras/api dev",
    "dev:web": "pnpm --filter @compras/web dev",
    "dev:api": "pnpm --filter @compras/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @compras/api test:integration",
    "lint": "pnpm -r --if-present lint",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @compras/database prisma:generate",
    "db:validate": "pnpm --filter @compras/database prisma:validate",
    "db:migrate": "pnpm --filter @compras/database prisma:migrate",
    "db:deploy": "pnpm --filter @compras/database prisma:deploy",
    "db:seed": "pnpm --filter @compras/database prisma:seed",
    "db:studio": "pnpm --filter @compras/database prisma:studio",
    "db:backup": "node scripts/backup-database.mjs",
    "db:backup:verify": "node scripts/verify-backup.mjs",
    "load:smoke": "node scripts/load-smoke.mjs"
  }
}
